{
  "name": "toefl-local-lab",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Offline TOEFL iBT practice with bilingual UI and portable personal resources",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:ui && npm run test:api && npm run test:data",
    "test:api": ".venv/bin/python -m pytest backend/tests tests/security -q",
    "import": ".venv/bin/python scripts/import_materials.py",
    "test:ui": "vitest run",
    "format": "prettier --write src public/styles.css vite.config.ts",
    "test:data": ".venv/bin/python -m pytest tests/data -q",
    "demo": ".venv/bin/python scripts/install_example.py",
    "import:pack": ".venv/bin/python scripts/import_pack.py",
    "check:docs": "python3 scripts/check_docs.py"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
